# Prophet Arena / AI Prophet
# Fill these into a private .env file. Do not commit real keys.
PA_SERVER_URL=https://api.aiprophet.dev
PA_SERVER_API_KEY=prophet_xxx_xxx
KALIBRE_TEAM_NAME=HarshadM

# Hackathon dev credits are issued via OpenRouter.
# The ai-prophet CLI treats unknown providers as OpenAI-compatible.
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Eval deployment defaults
# Slug will be auto-normalized to eval_<team-name>-<suffix> if needed.
# Leave PA_EXPERIMENT_SLUG unset to auto-generate eval_<team-name>-<timestamp>.
# PA_EXPERIMENT_SLUG=eval_harshadm
PA_MAX_TICKS=1500
PA_STARTING_CASH=10000
KALIBRE_STRATEGY_MODE=forecast_dry_run
KALIBRE_ENABLE_LIVE_TRADES=1

# Optional direct provider keys if you choose to use them instead.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# XAI_API_KEY=...

# Optional search providers for the built-in agent pipeline.
# BRAVE_API_KEY=...
# EXA_API_KEY=...
# TAVILY_API_KEY=...
# PERPLEXITY_API_KEY=...

# Optional local dataset override for forecast experiments.
PA_FORECAST_DATASETS_REPO_PATH=./ai-prophet-datasets
